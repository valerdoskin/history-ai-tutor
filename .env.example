# ============================================
# History AI Tutor — конфигурация
# Скопируйте в .env и заполните реальные ключи
# ============================================

# Токен бота от @BotFather
BOT_TOKEN=

# Домен для webhook (без https:// и без слэша)
WEBHOOK_DOMAIN=

# ============================================
# LLM (DeepSeek — основной, дешёвый)
# Получить: https://platform.deepseek.com/
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# Fallback LLM (Groq — бесплатный, быстрый)
# Получить: https://console.groq.com/keys
# ============================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ============================================
# Эмбеддинги (локальная multilingual-модель)
# ============================================
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ============================================
# Qdrant (векторная БД)
# Локально: http://localhost:6333
# Cloud: https://xxx.qdrant.tech
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=history_tutor

# ============================================
# База данных
# ============================================
DB_PATH=./tutor_bot.db

# ============================================
# Настройки обогащения (Этап 2)
# ============================================
# Максимальная длина текста параграфа для отправки в LLM (символов)
ENRICH_MAX_CHARS=6000
# Задержка между запросами к API (сек) — чтобы не превысить лимиты
ENRICH_DELAY=0.5
# Количество ретраев при ошибке API
ENRICH_MAX_RETRIES=3
# Локальный (embedded) режим Qdrant — используется если задан путь
# (не требует Docker; данные хранятся в указанной папке)
QDRANT_PATH=./knowledge/qdrant
